{
  "name": "ocr-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs && node scripts/check-dist.mjs",
    "start": "node dist/index.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "token": "node --disable-warning=ExperimentalWarning dist/cli/tokens.js",
    "token:dev": "tsx --disable-warning=ExperimentalWarning src/cli/tokens.ts",
    "typecheck": "tsc -p tsconfig.json",
    "japanese-search:install": "bash node_modules/ocr-search/scripts/install-sqlite-vaporetto.sh native/sqlite-vaporetto",
    "japanese-search:check": "node node_modules/ocr-search/scripts/check-sqlite-vaporetto.mjs --extension=native/sqlite-vaporetto/libsqlite_vaporetto.so",
    "japanese-search:index": "node node_modules/ocr-search/scripts/build-japanese-index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.1.1",
    "dotenv": "^16.4.7",
    "zod": "^4.0.0",
    "ocr-search": "https://github.com/studioddtonline/OCR-SEARCH/releases/download/v0.2.0/ocr-search-0.2.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
